# =============================================================================
# Soyara / FlipSwap DEX — Required Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ── GenLayer / Agent Configuration ───────────────────────────────────────────

# Private key of the wallet that was set as `authorisedAgent` in AgentExecutor.
# This is the same wallet used as `deployer` in deployGenlayer.sol.
# REQUIRED for:
#   - /api/genlayer-validate  → signs the GenLayer write transaction (validate_proposal @gl.public.write)
#   - /api/agent-execute      → calls approveTradeWithParams + executeSwap (onlyAgent)
AGENT_PRIVATE_KEY=0x<your_agent_private_key_here>

# Deployed address of AgentExecutor.sol on GenLayer Bradbury Testnet (chain 4221).
# Run: forge script script/deployGenlayer.sol --broadcast
# Then copy the "AgentExecutor deployed to:" address here.
AGENT_EXECUTOR_ADDRESS=0x<deployed_agent_executor_address>

# Optional: fee collection address (defaults to 0x48234eD645676b794a4CbC7483513e58cB04e22E)
FEE_COLLECTOR_ADDRESS=0x48234eD645676b794a4CbC7483513e58cB04e22E

# ── AI / Gemini Configuration ─────────────────────────────────────────────────
GEMINI_API_KEY=<your_gemini_api_key>

# ── Next.js Public Config ─────────────────────────────────────────────────────
NEXT_PUBLIC_AGENT_EXECUTOR_ADDRESS=0x<deployed_agent_executor_address>
NEXT_PUBLIC_CHAIN_ID=4221

# ── Agent lane pool (IMPORTANT for reliability) ──────────────────────────────
# GenLayer's ConsensusMain processes a pending queue PER SENDER, in strict order.
# A second consensus round from the same sender while an earlier one is pending
# reverts with TransactionNotAtPendingQueueHead() — which surfaces in the UI as a
# bogus "Rejected by Validator". With a single key the whole app is serialised
# behind one lane and one stuck round blocks every later action.
#
# Give each concurrent validation its own funded sender. Comma-separated.
# Every lane needs GEN for gas; only the settlement lane must be the
# authorisedAgent on AgentExecutor.
AGENT_PRIVATE_KEYS=0x<lane1>,0x<lane2>,0x<lane3>,0x<lane4>

# ── Trading mandate (IMPORTANT for latency) ──────────────────────────────────
# A mandate is approved ONCE by full GenVM consensus (issue_trading_mandate).
# Every trade inside its bounds is then validated by check_mandate, which is a
# @gl.public.view — instant, no consensus round, no activation wait. Settlement
# is still gated by AgentExecutor's per-trade one-time approval hash.
# Leave unset to validate every trade with its own (slow) consensus round.
GENLAYER_MANDATE_ID=
