# =============================================================================
# Soyara DEX: server environment for the agent settlement routes
# Copy into .env.local and fill in the values. Never commit .env.local.
# =============================================================================
#
# Contract addresses are NOT configured here. The app reads the deployed pair
# from constants/addresses.js (AgentExecutor 0x1BCBad3d..., AgentValidator IC
# 0xd1D809A1...), and the settlement routes prefer that map over any env value.

# ── Relaying agent ───────────────────────────────────────────────────────────
# The authorised agent on AgentExecutor (`onlyAgent`). It RELAYS settlements:
#   /api/agent-execute           executeSwap (the trade's own consensus verdict)
#                                or executeSwapUnderMandate (a consensus mandate)
#   /api/agent-add-liquidity     executeAddLiquidityV2
#   /api/agent-remove-liquidity  executeRemoveLiquidityV2
#   /api/finalize-round          nudges a round whose appeal window has closed
# It cannot authorise anything: recordVerdict and recordMandate accept only the
# AgentValidator Intelligent Contract, so an order no round approved reverts.
AGENT_PRIVATE_KEY=0x<authorised_agent_private_key>

# ── Consensus lanes ──────────────────────────────────────────────────────────
# Senders for consensus rounds (validate_swap, issue_trading_mandate,
# validate_liquidity_v2_*). GenLayer's ConsensusMain processes a pending queue
# PER SENDER, in strict order: a second round from the same sender while an
# earlier one is pending reverts with TransactionNotAtPendingQueueHead(), which
# used to surface as a bogus "Rejected by Validator". Give each concurrent round
# its own funded sender. Comma-separated; every lane needs GEN for gas.
AGENT_PRIVATE_KEYS=0x<lane1>,0x<lane2>,0x<lane3>,0x<lane4>

# ── Optional ─────────────────────────────────────────────────────────────────
# Fallback only, used if constants/addresses.js carries no executor.
# AGENT_EXECUTOR_ADDRESS=0x1BCBad3da718690fa60289DcBF15835e5C79021f
# Fee collector bound into every order, if constants/addresses.js has no dexFeeVault.
# FEE_COLLECTOR_ADDRESS=0x48234eD645676b794a4CbC7483513e58cB04e22E

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<your_gemini_api_key>

# ── Mandates ─────────────────────────────────────────────────────────────────
# Nothing to configure. A mandate is issued per user by a consensus round
# (issue_trading_mandate, requested through /api/agent-mandate), delivered to
# the executor by recordMandate when that round finalizes, and checked by the
# executor on every trade made under it. The browser remembers the ids a user
# was issued and sends them with each trade; there is no global mandate id.

# ── Settlement server (optional) ─────────────────────────────────────────────
# A separate always-on server that settles approved trades with every tab
# closed: github.com/Jubayerianj/soyaradex-server (runs on Railway). Set both to
# hand trades to it; this app then runs no keeper of its own. Leave them unset
# and this app's own keeper settles, which needs a long-running host.
# SETTLEMENT_SERVER_URL=https://<your-server>.up.railway.app
# SETTLEMENT_SERVER_KEY=<the server's SERVER_API_KEY>
