      { "name": "referrerFeeBps", "type": "uint256", "indexed": false },
      { "name": "totalFeeBps", "type": "uint256", "indexed": false }
    ],
    "anonymous": false
  },
  {
    "type": "event",
    "name": "FeeCollected",
