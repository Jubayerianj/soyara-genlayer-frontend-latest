  {
    "type": "error",
    "name": "AGGFlowEntrypoint_InsufficientNativeValue",
    "inputs": []
  },
  {
    "type": "error",
    "name": "AGGFlowEntrypoint_InvalidFeeCollector",
    "inputs": []
  },
  {
    "type": "error",
    "name": "AGGFlowEntrypoint_InvalidFeeStructure",
    "inputs": []
  },
  {
    "type": "error",
    "name": "AGGFlowEntrypoint_InvalidReferrer",
    "inputs": []
  },
  {
    "type": "error",
    "name": "AGGFlowEntrypoint_InvalidRouter",
    "inputs": []
